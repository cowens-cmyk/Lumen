<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Lumen</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Presentation</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.keynote.key</string>
				<string>org.openxmlformats.presentationml.presentation</string>
				<string>com.adobe.pdf</string>
				<string>public.image</string>
				<string>public.movie</string>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.video</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	<key>NSAppleEventsUsageDescription</key>
	<string>Lumen asks Keynote to export PowerPoint and Keynote files as slide images.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_ndi._tcp</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Lumen reads calendar events to trigger slides and macros at scheduled times.</string>
	<key>NSCameraUsageDescription</key>
	<string>Lumen uses capture devices (Apple TV, cameras, DeckLink inputs) as live video sources.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Hope Church</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lumen serves a remote control and stage display to phones and tablets on your network, and discovers NDI sources.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Lumen listens to the worship leader or pastor to follow lyrics and detect scripture references.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Lumen transcribes audio on this Mac to follow lyrics and detect scripture references.</string>
</dict>
</plist>
